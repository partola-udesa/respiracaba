# Para probar la función de IA en la compu: cp .env.example app/.env.local, completar la clave y correr `npx vercel dev` dentro de app/.
# En la app publicada, estas variables se cargan en Vercel → Settings → Environment Variables.
# .env.local está en .gitignore: la clave NUNCA se sube a GitHub.

# Obligatoria — https://console.groq.com/keys
GROQ_API_KEY=

# Opcionales (si no se completan se usan los modelos por defecto de app/api/ia.js)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_RAPIDO=llama-3.1-8b-instant

# Open-Meteo (clima por hora) NO necesita clave para uso no comercial.
